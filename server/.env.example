# Supabase Postgres. Prefer the "Session pooler" connection string over the
# direct connection: Supabase's direct host (db.[PROJECT-REF].supabase.co)
# resolves IPv6-only, which is unreachable from a lot of networks (mobile
# hotspots, some ISPs/corporate networks). The Session pooler (Supavisor)
# is IPv4-reachable and behaves like a direct connection for our purposes.
# Get it from: Supabase Dashboard → Project Settings → Database →
# Connection string → "Session pooler".
#
# connection_limit is capped deliberately — Prisma opens its own pool per
# process, and an uncapped pool against a shared pooler on a small Supabase
# plan exhausts available connections fast. When that happens, requests
# don't error, they just hang indefinitely, which is a confusing failure
# mode if you don't know to look for it.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30"

# App
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Field/file encryption — 32-byte key, hex-encoded (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars"

# Cloudflare Turnstile (CAPTCHA)
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"

# Uploads (local disk for now; swappable for S3-compatible storage later)
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=50
